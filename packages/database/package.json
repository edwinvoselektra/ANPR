{
  "name": "@anpr/database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "admin:create": "tsx src/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anpr/shared": "*",
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "prisma": "6.12.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "prisma": { "seed": "tsx src/seed.ts" }
}
