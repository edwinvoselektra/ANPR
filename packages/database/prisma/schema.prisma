generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CameraDirection {
  UNKNOWN
  INCOMING
  OUTGOING
  BOTH
}

enum CameraDirectionMapping {
  TOWARD_CAMERA_IS_INCOMING
  AWAY_FROM_CAMERA_IS_INCOMING
}

enum CameraStatus {
  ONLINE
  OFFLINE
  CONNECTION_PROBLEM
  ANPR_UNAVAILABLE
  DISABLED
}

enum CameraConnectionMode {
  URL
  FIELDS
}

enum CameraZoneType {
  RECTANGLE
  POLYGON
}

enum PassageSource {
  DEMO
  ANPR
  MANUAL
  DAHUA_CAMERA
  SERVER_OCR
}

enum CameraAnprProvider {
  NONE
  DAHUA_CGI
  DAHUA_ITSAPI
}

enum AnprConnectionStatus {
  DISABLED
  CONNECTING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum PassageStatus {
  ACTIVE
  REVIEW
  DELETED
}

enum VehicleType {
  CAR
  VAN
  TRUCK
  MOTORCYCLE
  BUS
  TRAILER
  UNKNOWN
}

enum VehicleColor {
  BLACK
  WHITE
  GRAY
  SILVER
  RED
  BLUE
  GREEN
  YELLOW
  BROWN
  ORANGE
  OTHER
  UNKNOWN
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum LocationRouterType {
  TP_LINK_OMADA_ER605
  MANUAL_OTHER
}

enum VpnType {
  WIREGUARD
}

enum VpnMode {
  SERVER_TO_LOCATION
  LOCATION_TO_SERVER
}

enum LocationConnectionStatus {
  UNKNOWN
  CONNECTING
  ONLINE
  DEGRADED
  OFFLINE
}

enum DeviceConnectionType {
  DAHUA_TCP_SDK
}

enum DeviceCategory {
  CAMERA
  NVR
  AUTO
}

enum DeviceConnectionStatus {
  UNKNOWN
  CONNECTING
  CONNECTED
  AUTH_FAILED
  OFFLINE
  ERROR
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique
  username           String               @unique
  displayName        String
  passwordHash       String
  active             Boolean              @default(true)
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  roles              UserRole[]
  sessions           UserSession[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  groupMembersAdded  PlateGroupMember[]   @relation("GroupMemberAddedBy")
  retentionExceptions RetentionException[]
  pushSubscriptions  PushSubscription[]
  notificationPreference NotificationPreference?
  notifications      Notification[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Camera {
  isDraft                  Boolean              @default(false)
  draftKey                 String?              @unique @db.Uuid
  draftExpiresAt           DateTime?
  configVersion            Int                  @default(1)
  videoTest                Json?
  videoTestVersion         Int?
  videoTestAt              DateTime?
  uploadRegistration       ItsapiRegistration?
  uploadInbox              ItsapiInbox[]

  rtspEnabled              Boolean              @default(true)
  archivedAt               DateTime?
  historicalName           String?
  id                       String               @id @default(uuid()) @db.Uuid
  name                     String               @unique
  location                 String
  description              String?
  connectionMode           CameraConnectionMode @default(FIELDS)
  rtspProtocol             String               @default("rtsp")
  rtspHost                 String?
  rtspPort                 Int                  @default(554)
  rtspPath                 String?
  rtspUsernameEncrypted    String?
  rtspPasswordEncrypted    String?
  direction                CameraDirection
  directionMapping         CameraDirectionMapping @default(TOWARD_CAMERA_IS_INCOMING)
  status                   CameraStatus         @default(DISABLED)
  lastConnectionAt         DateTime?
  lastConnectionSuccessAt  DateTime?
  lastConnectionErrorCode  String?
  lastConnectionError      String?
  lastVehicleRegistrationAt DateTime?
  lastSnapshotObjectId     String?
  active                   Boolean              @default(false)
  anprProvider             CameraAnprProvider   @default(NONE)
  anprHttpProtocol         String               @default("http")
  anprHttpPort             Int                  @default(80)
  anprChannel              Int                  @default(1)
  anprConnectionStatus     AnprConnectionStatus @default(DISABLED)
  lastAnprConnectionAt     DateTime?
  lastAnprEventAt          DateTime?
  lastAnprErrorCode        String?
  lastAnprError            String?
  capabilities             Json?
  anprSettings             Json?
  vehicleDetectionSettings Json?
  latitude                 Decimal?             @db.Decimal(9, 6)
  longitude                Decimal?             @db.Decimal(9, 6)
  displayOrder             Int                  @default(0)
  offlineTimeoutSeconds    Int                  @default(120)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  zones                    CameraZone[]
  passages                 Passage[]
  hits                     Hit[]
  locationId               String?              @db.Uuid
  recorderId               String?              @db.Uuid
  vpnLocation              VpnLocation?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  recorder                 Recorder?             @relation(fields: [recorderId], references: [id], onDelete: Restrict)
  deviceConnections        DeviceConnection[]

  @@index([active, displayOrder])
  @@index([status])
  @@index([locationId])
  @@index([recorderId])
}

model VpnLocation {
  timezone                   String @default("Europe/Amsterdam")
  id                         String                   @id @default(uuid()) @db.Uuid
  name                       String                   @unique
  description                String?
  routerType                 LocationRouterType
  vpnType                    VpnType                  @default(WIREGUARD)
  vpnMode                    VpnMode                  @default(LOCATION_TO_SERVER)
  tunnelAddress              String                   @unique
  remoteLanCidr              String
  remoteGatewayIp            String?
  endpointHost               String?
  listenPort                 Int                      @default(51820)
  mtu                        Int                      @default(1420)
  active                     Boolean                  @default(true)
  publicKey                  String?
  privateKeyEncrypted        String?
  connectionStatus           LocationConnectionStatus @default(UNKNOWN)
  tunnelOnline               Boolean?
  routeReachable             Boolean?
  recorderReachable          Boolean?
  recorderPortOpen           Boolean?
  lastHandshakeAt            DateTime?
  lastSeenAt                 DateTime?
  lastCheckedAt              DateTime?
  lastHealthErrorCode        String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  recorders                  Recorder[]
  cameras                    Camera[]

  @@index([active, name])
  @@index([connectionStatus])
}

model Recorder {
  id             String      @id @default(uuid()) @db.Uuid
  locationId     String      @db.Uuid
  name           String
  ipAddress      String
  rtspPort       Int         @default(554)
  channelCount   Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  location       VpnLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  cameras        Camera[]
  deviceConnections DeviceConnection[]

  @@unique([locationId, name])
  @@index([locationId])
}

model DeviceConnection {
  id                    String                 @id @default(uuid()) @db.Uuid
  type                  DeviceConnectionType
  cameraId              String?                @db.Uuid
  recorderId            String?                @db.Uuid
  host                  String
  port                  Int                    @default(37777)
  usernameEncrypted     String?
  passwordEncrypted     String?
  requestedCategory     DeviceCategory         @default(AUTO)
  detectedCategory      DeviceCategory?
  status                DeviceConnectionStatus @default(UNKNOWN)
  model                  String?
  firmware               String?
  serialNumber           String?
  channelCount           Int?
  channels               Json?
  capabilities          Json?
  lastTestAt             DateTime?
  lastSuccessAt          DateTime?
  lastErrorCode          String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  camera                 Camera?                @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  recorder               Recorder?              @relation(fields: [recorderId], references: [id], onDelete: Cascade)

  @@unique([cameraId, type])
  @@unique([recorderId, type])
  @@index([status])
  @@index([cameraId])
  @@index([recorderId])
}

model CameraZone {
  id        String         @id @default(uuid()) @db.Uuid
  cameraId  String         @db.Uuid
  name      String         @default("Herkenningsgebied")
  type      CameraZoneType
  points    Json
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  camera    Camera         @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
}

model Passage {
  timezone               String?
  id                     String          @id @default(uuid()) @db.Uuid
  originalLicensePlate   String
  normalizedLicensePlate String
  displayLicensePlate    String
  plateConfidence        Float?
  timestamp              DateTime        @default(now())
  cameraId               String          @db.Uuid
  location               String
  direction              CameraDirection
  vehicleColor           VehicleColor    @default(UNKNOWN)
  vehicleType            VehicleType     @default(UNKNOWN)
  vehicleConfidence      Float?
  vehicleBrand           String?
  plateCountry           String?
  lane                   Int?
  vehicleImage1ObjectId  String?
  vehicleImage2ObjectId  String?
  plateImageObjectId     String?
  isHit                  Boolean         @default(false)
  status                 PassageStatus   @default(ACTIVE)
  source                 PassageSource   @default(ANPR)
  sourceEventId          String?
  rawEventMetadata       Json?
  trackId                String?
  expiresAt              DateTime
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  camera                 Camera          @relation(fields: [cameraId], references: [id], onDelete: Restrict)
  vehicle                Vehicle?
  plateDetections        PlateDetection[]
  hits                   Hit[]
  retentionExceptions   RetentionException[]

  @@index([normalizedLicensePlate])
  @@index([timestamp])
  @@index([cameraId, timestamp])
  @@index([vehicleColor])
  @@index([vehicleType])
  @@index([isHit, timestamp])
  @@index([location, timestamp])
  @@index([direction, timestamp])
  @@index([expiresAt])
  @@unique([cameraId, source, sourceEventId])
}

model Vehicle {
  id         String        @id @default(uuid()) @db.Uuid
  passageId  String        @unique @db.Uuid
  type       VehicleType
  color      VehicleColor
  confidence Float?
  metadata   Json?
  createdAt  DateTime      @default(now())
  passage    Passage       @relation(fields: [passageId], references: [id], onDelete: Cascade)
}

model PlateDetection {
  id                     String   @id @default(uuid()) @db.Uuid
  passageId              String   @db.Uuid
  rawLicensePlate        String
  normalizedLicensePlate String
  confidence             Float
  frameObjectId          String?
  frameTimestampMs       Int?
  createdAt              DateTime @default(now())
  passage                Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([passageId])
  @@index([normalizedLicensePlate])
}

model PlateGroup {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String             @unique
  description          String?
  color                String
  icon                 String?
  hitEnabled           Boolean            @default(false)
  pushNotifications    Boolean            @default(false)
  active               Boolean            @default(true)
  reasonRequired       Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  members              PlateGroupMember[]
  hits                 Hit[]
  hitLinks             HitGroup[]
  notificationPreferences NotificationPreferenceGroup[]

  @@index([active])
}

model PlateGroupMember {
  id                     String     @id @default(uuid()) @db.Uuid
  groupId                String     @db.Uuid
  normalizedLicensePlate String
  displayLicensePlate    String
  reason                 String?
  description            String?
  note                   String?
  validFrom               DateTime?
  validUntil              DateTime?
  active                  Boolean    @default(true)
  addedById               String?    @db.Uuid
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  group                   PlateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedBy                 User?      @relation("GroupMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([groupId, normalizedLicensePlate])
  @@index([normalizedLicensePlate, active])
  @@index([groupId])
  @@index([groupId, active])
}

model Hit {
  id                     String             @id @default(uuid()) @db.Uuid
  passageId              String             @db.Uuid
  cameraId               String             @db.Uuid
  groupId                String             @db.Uuid
  normalizedLicensePlate String
  location               String
  timestamp              DateTime
  vehicleImageObjectId   String?
  plateImageObjectId     String?
  reason                 String?
  notificationSent       Boolean            @default(false)
  notificationStatus     NotificationStatus @default(PENDING)
  createdAt              DateTime           @default(now())
  passage                Passage            @relation(fields: [passageId], references: [id], onDelete: Cascade)
  camera                 Camera             @relation(fields: [cameraId], references: [id], onDelete: Restrict)
  group                  PlateGroup         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  groups                 HitGroup[]
  notifications          Notification[]

  @@unique([passageId])
  @@index([timestamp])
  @@index([normalizedLicensePlate])
  @@index([cameraId])
  @@index([groupId])
}

model HitGroup {
  hitId     String     @db.Uuid
  groupId   String     @db.Uuid
  reason    String?
  createdAt DateTime   @default(now())
  hit       Hit        @relation(fields: [hitId], references: [id], onDelete: Cascade)
  group     PlateGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([hitId, groupId])
  @@index([groupId])
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  hitId            String?            @db.Uuid
  recipientId      String?            @db.Uuid
  subscriptionId   String?            @db.Uuid
  deduplicationKey String             @unique
  channel          String
  status           NotificationStatus @default(PENDING)
  attemptCount     Int                @default(0)
  sentAt           DateTime?
  failureCategory  String?
  error            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  hit              Hit?               @relation(fields: [hitId], references: [id], onDelete: Cascade)
  recipient        User?              @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  subscription     PushSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([hitId])
  @@index([recipientId, status])
  @@index([subscriptionId, status])
}

model PushSubscription {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  endpoint         String         @unique
  p256dh            String
  auth              String
  userAgent         String?
  deviceName        String?
  enabled           Boolean        @default(true)
  lastSuccessfulAt DateTime?
  failureCount      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications    Notification[]

  @@index([userId, enabled])
}

model NotificationPreference {
  id           String                        @id @default(uuid()) @db.Uuid
  userId       String                        @unique @db.Uuid
  pushEnabled  Boolean                       @default(false)
  allHitGroups Boolean                       @default(true)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups       NotificationPreferenceGroup[]
}

model NotificationPreferenceGroup {
  preferenceId String                 @db.Uuid
  groupId      String                 @db.Uuid
  preference   NotificationPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  group        PlateGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([preferenceId, groupId])
  @@index([groupId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  objectType String?
  objectId   String?
  ipAddress  String?
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([objectType, objectId])
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model RetentionException {
  id                String   @id @default(uuid()) @db.Uuid
  passageId         String   @db.Uuid
  userId            String   @db.Uuid
  reason            String
  originalExpiresAt DateTime
  newExpiresAt      DateTime
  createdAt         DateTime @default(now())
  passage           Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([passageId])
  @@index([newExpiresAt])
}

// A registration is independent of the credentials used to read video from the camera.
model ItsapiRegistration {
  cameraId             String   @id @db.Uuid
  camera               Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  username             String   @unique
  passwordEncrypted    String
  expectedDeviceId     String?
  protocolVersion      String?
  receiverOrigin       String?
  heartbeatSeconds     Int      @default(300)
  debugUntil           DateTime?
  lastRequestAt        DateTime?
  lastAuthenticatedAt  DateTime?
  lastIdentityAt       DateTime?
  lastHeartbeatAt      DateTime?
  lastEventAt          DateTime?
  lastErrorCode        String?
  evidenceVersion      Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ItsapiDigestReplay {
  key        String   @id
  count      Int
  expiresAt  DateTime
  @@index([expiresAt])
}

// Unknown protocol messages contain shape-only evidence, never an unfiltered request body.
model ItsapiInbox {
  id            String   @id @default(uuid()) @db.Uuid
  cameraId      String   @db.Uuid
  camera        Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  configVersion Int
  fingerprint   String
  state         String   @default("UNSUPPORTED")
  kind          String   @default("UNKNOWN")
  evidence      Json
  attempts      Int      @default(1)
  receivedAt    DateTime @default(now())
  lastReceivedAt DateTime @default(now())
  expiresAt     DateTime
  @@unique([cameraId, configVersion, fingerprint])
  @@index([expiresAt])
  @@index([cameraId, receivedAt])
}
