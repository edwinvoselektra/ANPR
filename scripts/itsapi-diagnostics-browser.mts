import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { cp, mkdir } from "node:fs/promises";
import { resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { setTimeout as delay } from "node:timers/promises";
import { prisma } from "../apps/api/src/lib/prisma.js";
import { buildServer } from "../apps/api/src/server.js";
import { buildItsapiReceiver } from "../apps/api/src/itsapi-receiver.js";
import { assertDiagnosticTestDatabase,createDiagnosticFixture,preservationSnapshot,syntheticPayload,syntheticPassword,jpeg } from "./itsapi-diagnostics-fixture.mjs";
assertDiagnosticTestDatabase();
const {chromium}=await import(pathToFileURL(resolve("data/diagnostics-browser/node_modules/playwright/index.mjs")).href);
const evidence=resolve("data/itsapi-diagnostics-browser-evidence");await mkdir(evidence,{recursive:true});
const standalone=resolve("apps/web/.next/standalone/apps/web");
await cp(resolve("apps/web/.next/static"),resolve(standalone,".next/static"),{recursive:true});
await cp(resolve("apps/web/public"),resolve(standalone,"public"),{recursive:true});
const fixture=await createDiagnosticFixture(prisma);
await prisma.itsapiRegistration.update({where:{cameraId:fixture.cameraId},data:{expectedSourceIp:"127.0.0.1"}});
const api=buildServer();api.log.level="silent";
const receiver=buildItsapiReceiver(prisma,fixture.storage);receiver.log.level="silent";
let web:ReturnType<typeof spawn>|undefined,browser:any;
const errors:string[]=[];
try {
  await api.listen({host:"127.0.0.1",port:4401});await receiver.listen({host:"127.0.0.1",port:7702});
  web=spawn(process.execPath,[resolve(standalone,"server.js")],{env:{...process.env,NODE_ENV:"production",HOSTNAME:"127.0.0.1",PORT:"3400"},stdio:"pipe"});
  let webOutput="";web.stdout?.on("data",chunk=>{webOutput=(webOutput+String(chunk)).slice(-8000)});web.stderr?.on("data",chunk=>{webOutput=(webOutput+String(chunk)).slice(-8000)});
  let ready=false;
  for(let i=0;i<80;i++){if(web.exitCode!==null)throw new Error(`Testwebserver stopped: ${webOutput}`);try{const r=await fetch("http://127.0.0.1:3400/login");if(r.ok){ready=true;break}}catch{}await delay(250)}
  assert.ok(ready,"Standalone testwebserver did not start");
  browser=await chromium.launch({headless:true});
  const context=await browser.newContext({viewport:{width:1440,height:1000},permissions:["clipboard-read","clipboard-write"]});
  const page=await context.newPage();page.on("pageerror",error=>errors.push(error.message));
  await page.goto("http://localhost:3400/login");
  await page.getByLabel("E-mail of gebruikersnaam").fill("diagnostics-admin");await page.getByLabel("Wachtwoord",{exact:true}).fill(syntheticPassword);
  await page.getByRole("button",{name:"Inloggen",exact:true}).click();await page.waitForURL("http://localhost:3400/");
  await page.getByRole("link",{name:"Camera’s",exact:true}).click();await page.waitForURL("**/cameras");
  const card=page.locator("article").filter({has:page.getByRole("heading",{name:"Staverhul",exact:true})});
  await card.getByRole("link",{name:"Diagnose",exact:true}).click();await page.waitForURL(`**/cameras/${fixture.cameraId}/diagnose`);
  await page.getByRole("heading",{name:"Cameradiagnose — Staverhul",exact:true}).waitFor();
  const panel=page.getByRole("region",{name:"ITSAPI-structuurdiagnose — Staverhul"});
  await panel.getByRole("button",{name:"Start structuurdiagnose (15 minuten)"}).waitFor();
  const before=await preservationSnapshot(prisma,fixture.otherCameraId,fixture.objectId);
  await panel.getByRole("button",{name:"Start structuurdiagnose (15 minuten)"}).click();await panel.getByRole("button",{name:"Diagnose stoppen"}).waitFor();
  await panel.getByText(/Wachten op een volgend afgewezen camerabericht sinds/).waitFor();
  const upload=await fetch("http://127.0.0.1:7702/NotificationInfo/TollgateInfo",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(syntheticPayload())});assert.equal(upload.status,422);
  await panel.getByRole("button",{name:"Diagnose verversen"}).click();await panel.getByRole("heading",{name:"Laatste afwijzing — HTTP 422"}).waitFor();
  const table=await panel.getByRole("table").innerText();for(const value of ["Picture.Plate.IsExist","boolean","null","invalid_type"])assert.ok(table.includes(value));
  assert.doesNotMatch(await panel.innerText(),/PRIVATE123|SYNTHETIC_PRIVATE_DEVICE|SYNTHETIC_ENCRYPTED_CREDENTIAL|SYNTHETIC_PUSH/);
  assert.equal(await panel.getByRole("table").evaluate((element:Element)=>Boolean(element.closest("details"))),false);
  await panel.screenshot({path:resolve(evidence,"desktop.png")});
  await panel.getByRole("button",{name:"Veilig rapport kopiëren"}).click();await panel.getByText("Veilig diagnoserapport gekopieerd.").waitFor();
  const copied=await page.evaluate(()=>navigator.clipboard.readText());assert.doesNotMatch(copied,/PRIVATE123|SYNTHETIC_PRIVATE_DEVICE|SYNTHETIC_ENCRYPTED_CREDENTIAL/);assert.equal(JSON.parse(copied).messages[0].violations[0].path,"Picture.Plate.IsExist");
  const image=await context.request.get(`http://localhost:3400/api/passages/${fixture.passageId}/image/overview`);assert.equal(image.status(),200);assert.deepEqual(await image.body(),jpeg);
  await page.setViewportSize({width:390,height:844});
  await page.waitForFunction(()=>document.querySelector(".sidebar")!.getBoundingClientRect().right<=0.5);
  await page.evaluate(()=>window.scrollTo(0,0));await page.screenshot({path:resolve(evidence,"mobile.png")});
  await panel.getByRole("table").evaluate((element:Element)=>element.scrollIntoView({block:"center"}));await page.screenshot({path:resolve(evidence,"mobile-table.png")});
  assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth),true,"Mobile page overflow");
  await panel.getByRole("button",{name:"Diagnose stoppen"}).click();await panel.getByText("Uitgeschakeld",{exact:true}).waitFor();
  await panel.getByRole("button",{name:"Start structuurdiagnose (15 minuten)"}).click();await panel.getByRole("button",{name:"Diagnose stoppen"}).waitFor();
  await prisma.itsapiRegistration.update({where:{cameraId:fixture.cameraId},data:{debugUntil:new Date(Date.now()+1500)}});
  await panel.getByRole("button",{name:"Diagnose verversen"}).click();await panel.getByText("Uitgeschakeld",{exact:true}).waitFor({timeout:15_000});
  assert.deepEqual(await preservationSnapshot(prisma,fixture.otherCameraId,fixture.objectId),before);
  const operator=await browser.newContext();const op=await operator.newPage();op.on("pageerror",error=>errors.push(error.message));
  await op.goto("http://localhost:3400/login");await op.getByLabel("E-mail of gebruikersnaam").fill("diagnostics-operator");await op.getByLabel("Wachtwoord",{exact:true}).fill(syntheticPassword);await op.getByRole("button",{name:"Inloggen",exact:true}).click();await op.waitForURL("http://localhost:3400/");
  await op.goto(`http://localhost:3400/cameras/${fixture.cameraId}/diagnose`);await op.getByRole("heading",{name:"Cameradiagnose — Staverhul",exact:true}).waitFor();
  await op.getByRole("heading",{name:"ITSAPI-parser en bevestiging",exact:true}).waitFor();assert.equal(await op.getByRole("button",{name:"Start structuurdiagnose (15 minuten)"}).count(),0);
  assert.equal((await operator.request.get(`http://localhost:3400/api/cameras/${fixture.cameraId}/itsapi/diagnostic`)).status(),403);
  assert.equal(errors.length,0,`Browser errors: ${errors.join("; ")}`);
  console.log("Browserketen geslaagd: echte login, Camera’s → Staverhul → Cameradiagnose, start/wachten/HTTP 422/veldtabel, veilig kopiëren, handmatig stoppen, automatische afloop, operatorweigering, mobiel 390 px en behoud van gegevens/afbeeldingsbytes. Geen browserfouten.");
} finally {
  await browser?.close();web?.kill("SIGTERM");await receiver.close();await api.close();await prisma.$disconnect();
}
