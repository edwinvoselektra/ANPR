# Kopieer dit bestand naar .env en vervang alle CHANGE_ME-waarden.
# Commit .env nooit naar Git.
POSTGRES_DB=anpr
POSTGRES_USER=anpr_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

# Interne serviceverbindingen voor Docker Compose.
DATABASE_URL=postgresql://anpr_app:CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/anpr?schema=public
REDIS_URL=redis://redis:6379

# Exact 64 hex-tekens (32 random bytes), bijvoorbeeld gemaakt met:
# openssl rand -hex 32
CAMERA_CREDENTIALS_KEY=CHANGE_ME_64_HEX_CHARACTERS

NODE_ENV=development
DEMO_MODE=true
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_DAYS=7
STORAGE_PATH=/app/storage
API_PORT=4000
NEXT_PUBLIC_API_BASE=/api

# Fase 2.4 Web Push. Maak deze sleutels zelf aan; plaats nooit de private key in Git.
# Exact commando en uitleg staan in README.md en docs/PHASE2.4-RESULT.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:beheerder@example.invalid

# Fase 2.1 video-worker. 0.1 FPS betekent één testframe per 10 seconden per camera.
# De veilige limiet is maximaal 1 FPS; dit is nog geen permanente opname of ANPR.
VIDEO_WORKER_PORT=4100
VIDEO_SAMPLE_FPS=0.1
VIDEO_RETRY_SECONDS=10
VIDEO_CAMERA_REFRESH_SECONDS=10
VIDEO_CAPTURE_TIMEOUT_SECONDS=15

# Fase 2.2 ANPR-eventworker. Camera-endpoints zijn vast in de provider en niet via
# environmentvariabelen of de browser instelbaar.
ANPR_WORKER_PORT=4200
ANPR_CAMERA_REFRESH_SECONDS=10
ANPR_RECONNECT_MIN_SECONDS=2
ANPR_RECONNECT_MAX_SECONDS=60
ANPR_CONNECT_TIMEOUT_SECONDS=10
ANPR_DEDUPE_WINDOW_SECONDS=3
ANPR_MAX_IMAGE_BYTES=8000000

# Fase 2.4.5 VPN-locaties. Het endpoint blijft wijzigbaar zonder locaties opnieuw
# aan te maken. VPN_STATUS_FILE is optioneel en wijst naar een door een beperkte
# host-adapter geschreven JSON-statusfile; geef Docker niet zomaar NET_ADMIN.
VPN_TUNNEL_CIDR=10.100.0.0/24
VPN_SERVER_ADDRESS=10.100.0.1
VPN_SERVER_ENDPOINT=
VPN_LISTEN_PORT=51820
VPN_HEALTH_INTERVAL_SECONDS=30
VPN_HEALTH_TIMEOUT_MS=2000
VPN_STATUS_FILE=

# Gedeelde ITSAPI-uploadontvanger; LAN/VPN-adres moet de admin per camera bevestigen.
ITSAPI_BIND_ADDRESS=0.0.0.0
ITSAPI_PUBLISHED_PORT=7070

# IANA timezone for standalone cameras and searches across multiple regions
PLATFORM_TIMEZONE=Europe/Amsterdam
