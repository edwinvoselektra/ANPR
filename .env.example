# Kopieer dit bestand naar .env en vervang alle CHANGE_ME-waarden.
# Commit .env nooit naar Git.
POSTGRES_DB=anpr
POSTGRES_USER=anpr_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

# Interne serviceverbindingen voor Docker Compose.
DATABASE_URL=postgresql://anpr_app:CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/anpr?schema=public
REDIS_URL=redis://redis:6379

# Exact 64 hex-tekens (32 random bytes), bijvoorbeeld gemaakt met:
# openssl rand -hex 32
CAMERA_CREDENTIALS_KEY=CHANGE_ME_64_HEX_CHARACTERS

NODE_ENV=development
DEMO_MODE=true
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
STORAGE_PATH=/app/storage
API_PORT=4000
NEXT_PUBLIC_API_BASE=/api
